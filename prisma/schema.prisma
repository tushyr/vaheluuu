datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RecipientSession {
  id           String              @id @default(cuid())
  sessionToken String              @unique
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime            @default(now())
  createdAt    DateTime            @default(now())
  responses    RecipientResponse[]
  rewards      RewardRecord[]
}

model RecipientResponse {
  id           String           @id @default(cuid())
  sessionId    String
  session      RecipientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chapterKey   String
  moduleId     String
  questionKey  String
  questionText String
  chosenAnswer String
  score        Int?             @default(0)
  metadataJson String? // Extra answers/data in JSON
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([sessionId, chapterKey, questionKey])
}

model RewardRecord {
  id                      String           @id @default(cuid())
  sessionId               String
  session                 RecipientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chapterKey              String
  rewardKey               String
  rewardTitle             String
  rewardType              String           @default("PHYSICAL") // PHYSICAL or DIGITAL
  isPhysicalGift          Boolean          @default(true)
  physicalGiftDescription String?
  fulfillmentStatus       String           @default("PENDING") // PENDING, ORDERED, READY, DELIVERED
  creatorNotes            String?
  wonAt                   DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([sessionId, chapterKey])
}
